# Uploaded documents must never be executed or listed.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi
php_flag engine off
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [F,L]
</IfModule>

# Fallback for servers without mod_rewrite/mod_php directives.
<FilesMatch "\.(php|phtml|php[0-9]?|pl|py|cgi|asp|aspx|jsp|sh)$">
  Require all denied
</FilesMatch>
